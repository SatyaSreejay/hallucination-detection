# Copy to .env and adjust. Environment variables override .env values.

# --- Answer generation backend: groq (default) | openrouter | openai | custom | ollama
# Groq free tier: create a key at https://console.groq.com/keys and paste it below.
# Never commit .env; it is listed in .gitignore.
LLM_PROVIDER=groq
# Empty = provider default (groq: openai/gpt-oss-20b). Must be in the list `python -m src.cli status` prints.
LLM_MODEL=
# Only needed for LLM_PROVIDER=custom (any OpenAI-compatible /v1 endpoint)
LLM_BASE_URL=
LLM_TIMEOUT=60
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Generic fallback key, used if the provider-specific variable is empty
LLM_API_KEY=

# --- Ollama (local LLM, only used when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.2

# --- Claim extraction: spacy (Sentencizer) | llm (spaCy + LLM decomposition)
CLAIM_EXTRACTOR=spacy
MAX_CLAIMS=10

# --- Wikipedia retrieval (please put a contact in the user agent, per Wikimedia policy)
WIKI_USER_AGENT=HallucinationDetectionPrototype/0.1 (your-email@example.com)
WIKI_TIMEOUT=10
WIKI_MAX_RETRIES=3
WIKI_SEARCH_RESULTS=3
WIKI_PASSAGES_PER_CLAIM=3

# --- Verifier: auto | nli | llm
VERIFIER=auto
# Hugging Face id or a local checkpoint such as models/fever-verifier
NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall
# Leave empty for argmax; only set values found by `evaluate_verifier.py --tune` on validation data
NLI_SUPPORT_THRESHOLD=
NLI_CONTRADICTION_THRESHOLD=

RANDOM_SEED=13
